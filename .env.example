# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Confidential code required to access the studio CMS panel.
# If not set, falls back to config.json.
ADMIN_PASSCODE="change_this_to_your_secure_password"

# ADMIN_SECRET: Secret key used to sign and verify HMAC-SHA256 session tokens.
ADMIN_SECRET="generate_a_random_32_char_secret_key"

# GITHUB_TOKEN: (Optional) Personal access token with repo scope.
# Used on Vercel to automatically commit changes in data/creations.json back to GitHub.
GITHUB_TOKEN=""
GITHUB_REPO="BLURDVNIXL/Portfolio"
GITHUB_BRANCH="main"

